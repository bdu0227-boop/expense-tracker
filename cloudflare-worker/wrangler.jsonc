{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expense-tracker-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "EXPENSES_DB",
      "database_name": "expense-tracker-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
